# aiserver(FastAPI) 주소. 비워 두면 대시보드는 예시 판단으로 동작한다.
AISERVER_URL=http://127.0.0.1:8000
# aiserver 응답 대기 시간(ms). aiserver의 재배치 예산 0.5초 + 네트워크 여유.
AISERVER_TIMEOUT_MS=1500
# 1이면 서버 시작부터 시연용 자동 주문을 넣는다. 대시보드 상단 버튼으로도 켜고 끌 수 있다.
DEMO_FEED=0
# 재고 SQLite 파일. 처음 실행할 때 data/inventory.json으로 채운다. 지우고 다시 띄우면 처음 재고로 돌아간다.
INVENTORY_DB=.data/inventory.sqlite
# 0이면 시연용 자동 주문(source: demo)은 재고에서 빼지 않는다. 실제 QR 키오스크/배달 주문만 셀 때 쓴다.
INVENTORY_COUNT_DEMO=1
